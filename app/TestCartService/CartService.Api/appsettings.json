{
  "AllowedHosts": "*",
  "Application": {
    "CacheExpirationInMinutes": 30
  },
  "Infrastructure": {
    "Cache": {
      "Host": "localhost",
      "Port": 6379
    },
    "Database": {
      "ConnectionString": "Server=localhost;Database=cart_db;User Id=cart_user;Password=cart_password;"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
